generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  PROVIDER
  ADMIN
}

enum Unit {
  PIECE
  BAG
  METER
  SQUARE_METER
  CUBIC_METER
  TON
  ROLL
  LITER
  OTHER
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_DELETION
}

// AUDIT COLUMNS (every model except ActivityLog)
//   createdAt, updatedAt, createdById, updatedById are maintained by database triggers
//   (see prisma/migrations/*_audit_foundation). Do not set them in application code.
//   Actor columns are plain ids on purpose (no foreign key): User never needs a new relation
//   line when a table is added, and history survives deleting a user.
//   deletedAt / deletedById exist on business tables; nothing filters on them yet.

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String?
  phone             String?
  password          String? // for email/password login
  role              Role      @default(CLIENT)
  emailVerified     DateTime?
  image             String?
  passwordChangedAt DateTime?

  // Account state and preferences, added now so User does not change again.
  // status is not enforced yet; the permission guard will refuse non-ACTIVE users.
  status          UserStatus @default(ACTIVE)
  suspendedReason String?
  lastLoginAt     DateTime?
  locale          String?
  timezone        String?
  preferences     Json?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  deletedById String?

  accounts      Account[]
  sessions      Session[]
  loginSessions LoginSession[]
  provider      Provider?
}

model Provider {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName String
  description  String?
  phone        String?
  address      String?
  city         String
  governorate  String?
  latitude     Float?
  longitude    Float?

  isVerified  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  deletedById String?

  products    Product[]
  suggestions CatalogSuggestion[]
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  nameAr      String?
  slug        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  sortOrder   Int        @default(0)

  catalogItems CatalogItem[]
  products     Product[]
  suggestions  CatalogSuggestion[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  deletedById String?
}

model CatalogItem {
  id          String   @id @default(cuid())
  name        String
  nameAr      String?
  slug        String   @unique
  description String?
  brand       String?
  unit        Unit     @default(PIECE)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  images      String[]
  isActive    Boolean  @default(true)

  products    Product[]
  suggestions CatalogSuggestion[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  deletedById String?

  @@index([categoryId])
  @@index([name])
}

// A provider's request to add an item to the shared catalogue.
// Created alongside a custom product; on approval the product is linked to the
// resulting CatalogItem so it joins price comparisons.
model CatalogSuggestion {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  // The provider's custom product that triggered the suggestion (relinked on approval)
  productId String?  @unique
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  name       String
  nameAr     String?
  brand      String?
  unit       Unit     @default(PIECE)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  note       String?

  status     SuggestionStatus @default(PENDING)
  reviewNote String?
  reviewedAt DateTime?

  // Set when approved (new item) or merged into an existing one
  catalogItemId String?
  catalogItem   CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([status, createdAt])
  @@index([providerId])
}

model Product {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  // Optional link to the shared catalogue — enables price comparison
  catalogItemId String?
  catalogItem   CatalogItem? @relation(fields: [catalogItemId], references: [id])

  // Provider's own data (can differ from catalogue)
  name        String
  nameAr      String?
  description String?
  brand       String?
  sku         String?
  unit        Unit    @default(PIECE)

  price       Decimal @db.Decimal(12, 3)
  stock       Int     @default(0)
  isActive    Boolean @default(true)
  minOrderQty Int?

  // Useful for free-form products that have no catalogItem
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  images String[]

  suggestion CatalogSuggestion?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  deletedById String?

  // A provider lists a given catalogue item at most once (NULLs stay allowed
  // for free-form products). Also serves lookups by providerId.
  @@unique([providerId, catalogItemId])
  @@index([providerId])
  @@index([catalogItemId])
  @@index([categoryId])
  @@index([name])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  updatedById String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  updatedById String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  updatedById String?

  @@unique([identifier, token])
}

model PasswordResetToken {
  id          String   @id @default(cuid())
  email       String
  token       String   @unique
  expires     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  updatedById String?

  @@index([email])
}

model LoginSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Client info
  userAgent   String?
  ip          String?
  deviceLabel String? // e.g. "Chrome on Windows"

  // Lifecycle
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  revokedAt    DateTime?

  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  updatedById String?

  @@index([userId])
}

// Append-only history of changes. Rows are written by database triggers on every audited table
// (and by logActivity() for events that are not row changes, such as logins or impersonation).
// The application never updates or deletes rows. No foreign keys, so history survives the
// deletion of users, shops and records. Actor name and role are copied at write time.
model ActivityLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  entityType String
  entityId   String?
  providerId String? // set for shop-scoped records; powers the shop activity feed
  action     String
  changes    Json? // [{ field, from, to }] with secrets redacted
  note       String?

  actorId         String?
  actorName       String?
  actorRole       String?
  onBehalfOfId    String? // the user being impersonated, if any
  impersonationId String?

  source    String  @default("SYSTEM")
  requestId String?
  ip        String?
  userAgent String?

  @@index([entityType, entityId, createdAt])
  @@index([providerId, createdAt])
  @@index([actorId, createdAt])
}

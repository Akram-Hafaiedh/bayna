generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Which area opens after sign-in (not what the person may do: permissions come from AccessAssignment).
//   CLIENT   a customer
//   COMPANY  someone who works in a business or shop (opens /shop)
//   ADMIN    Bayna staff
enum Role {
  CLIENT
  COMPANY
  ADMIN
}

enum Unit {
  PIECE
  BAG
  METER
  SQUARE_METER
  CUBIC_METER
  TON
  ROLL
  LITER
  OTHER
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_DELETION
}

// How a shop's coordinates were set. A pin the shop placed is trusted over a guess.
//   LOOKUP    the centre of the chosen governorate (a starting point, not an address)
//   PIN       the shop clicked or dragged the map pin, or used his device location
//   GEOCODED  the shop picked an address search result
//   IMPORTED  loaded by a seed or script, never confirmed by the shop
enum LocationSource {
  LOOKUP
  PIN
  GEOCODED
  IMPORTED
}

enum AccessScope {
  PLATFORM
  BUSINESS // applies to every shop of one business
  SHOP // applies to one shop
}

enum AssignmentStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

// AUDIT COLUMNS (every model except ActivityLog)
//   createdAt, updatedAt, createdById, updatedById are maintained by database triggers
//   (see prisma/migrations/*_audit_triggers). Do not set them in application code.
//   Actor columns are plain ids on purpose (no foreign key): User never needs a new relation
//   line when a table is added, and history survives deleting a user.
//   deletedAt / deletedById exist on business tables; nothing filters on them yet.

model User {
  id                String    @id @default(cuid())
  // Opaque id for URLs (/admin/users/[publicUserId]), like Shop.publicShopId, so an address never shows the real id.
  publicUserId      String    @unique @default(cuid())
  email             String    @unique
  name              String?
  phone             String?
  password          String? // for email/password login
  role              Role      @default(CLIENT)
  emailVerified     DateTime?
  image             String?
  passwordChangedAt DateTime?

  // Account state and preferences, added now so User does not change again.
  // status is not enforced yet; the permission guard will refuse non-ACTIVE users.
  status              UserStatus @default(ACTIVE)
  suspendedReason     String?
  lastLoginAt         DateTime?
  // Set when the person asked to delete their account (status PENDING_DELETION); the account is anonymised
  // GRACE_DAYS later (lib/account-deletion.ts) unless they sign in before that, which cancels it.
  deletionRequestedAt DateTime?
  // The Terms and Privacy policy accepted at sign-up: when, and which version (LEGAL_VERSION in lib/site.ts).
  // Empty for accounts created before the acceptance existed.
  termsAcceptedAt     DateTime?
  termsVersion        String?
  locale              String?
  timezone            String?
  preferences         Json?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  deletedById String?

  accounts      Account[]
  sessions      Session[]
  loginSessions LoginSession[]
  // The shops this person applied for. Who works in a shop is AccessAssignment, not this.
  appliedShops  Shop[]

  // Permissions come from these, never from User.role (which only decides which dashboard opens).
  accessAssignments AccessAssignment[]
  notifications     Notification[]
  // Messages this person sent from the Contact page while signed in
  contactMessages   ContactMessage[]
}

// One outlet: what customers see, find and buy from. It always belongs to one Business (the company).
model Shop {
  id           String @id @default(cuid())
  // Opaque id for URLs (for example /shop/[publicShopId]); never guessable, unlike a counter.
  publicShopId String @unique @default(cuid())
  // The person who applied for the shop. Who works in it, and as what, is AccessAssignment (the applicant becomes owner on approval).
  applicantId  String
  applicant    User   @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  // The name of the shop itself, not of the company (that is Business.name).
  name           String
  description    String?
  phone          String?
  whatsapp       String?
  address        String?
  city           String
  governorate    String?
  latitude       Float?
  longitude      Float?
  // null while there are no coordinates
  locationSource LocationSource?

  // Where the shop is in its life; only ACTIVE shops can be opened and sell (see lib/shop-status.ts).
  status      ShopStatus @default(PENDING)
  // Set when an active shop changes its name, address, city, governorate or location, so an admin
  // sees it in the shops list. The shop stays live. Cleared by "Mark reviewed".
  needsReview Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  deletedById String?

  // The business (company) this shop belongs to. Every shop has one.
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  products          Product[]
  suggestions       CatalogSuggestion[]
  accessAssignments AccessAssignment[]
  accessRoles       AccessRole[]
  invites           AccessInvite[]

  @@index([applicantId])
  @@index([businessId])
}

enum ShopStatus {
  DRAFT
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

// The trader or company behind one or more shops (one legal entity). A shop is one outlet of it.
// Holds what is true for the whole business: legal and billing details, its owners (business-level
// assignments, which apply to every shop) and, later, its plan. Address, map pin, hours, stock and
// orders belong to the shop.
model Business {
  id               String  @id @default(cuid())
  // Opaque id for URLs, like Shop.publicShopId
  publicBusinessId String  @unique @default(cuid())
  name             String // trade name, shown to staff
  legalName        String? // official company name
  taxId            String? // matricule fiscal
  registryNumber   String? // trade registry number (RNE)
  billingEmail     String?
  billingPhone     String?
  billingAddress   String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  deletedById String?

  shops             Shop[]
  accessAssignments AccessAssignment[]
  accessRoles       AccessRole[]
  invites           AccessInvite[]
  // The plan this business pays for; none = the free plan (see lib/plans.ts)
  subscription      Subscription?
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  nameAr      String?
  slug        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  sortOrder   Int        @default(0)

  catalogItems CatalogItem[]
  products     Product[]
  suggestions  CatalogSuggestion[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  deletedById String?
}

model CatalogItem {
  id          String   @id @default(cuid())
  name        String
  nameAr      String?
  slug        String   @unique
  description String?
  brand       String?
  unit        Unit     @default(PIECE)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  images      String[]
  isActive    Boolean  @default(true)

  products    Product[]
  suggestions CatalogSuggestion[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  deletedById String?

  @@index([categoryId])
  @@index([name])
}

// A shop's request to add an item to the shared catalogue.
// Created alongside a custom product; on approval the product is linked to the
// resulting CatalogItem so it joins price comparisons.
model CatalogSuggestion {
  id         String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // The shop's custom product that triggered the suggestion (relinked on approval)
  productId String?  @unique
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  name       String
  nameAr     String?
  brand      String?
  unit       Unit     @default(PIECE)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  note       String?

  status     SuggestionStatus @default(PENDING)
  reviewNote String?
  reviewedAt DateTime?

  // Set when approved (new item) or merged into an existing one
  catalogItemId String?
  catalogItem   CatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([status, createdAt])
  @@index([shopId])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  HIDDEN
  BLOCKED
}

model Product {
  id         String @id @default(cuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  // Optional link to the shared catalogue — enables price comparison
  catalogItemId String?
  catalogItem   CatalogItem? @relation(fields: [catalogItemId], references: [id])

  // Shop's own data (can differ from catalogue)
  name        String
  nameAr      String?
  description String?
  brand       String?
  sku         String?
  unit        Unit    @default(PIECE)

  price       Decimal       @db.Decimal(12, 3)
  stock       Int           @default(0)
  // DRAFT, ACTIVE, HIDDEN or BLOCKED (by the platform team); see lib/product-status.ts
  status      ProductStatus @default(ACTIVE)
  minOrderQty Int?

  // When the price was last set or confirmed by the shop. Null for products from before this was
  // tracked, which reads as "unknown", not as "today".
  priceUpdatedAt    DateTime?
  // Raised when something outside the shop makes the price doubtful (for example the catalogue unit
  // changed from piece to box). Such a product is left out of comparison and cannot be ordered until a
  // person who may edit prices confirms the price.
  needsPriceReview  Boolean   @default(false)
  priceReviewReason String?

  // Useful for free-form products that have no catalogItem
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  images String[]

  suggestion CatalogSuggestion?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?
  updatedById String?
  deletedAt   DateTime?
  deletedById String?

  // A shop lists a given catalogue item at most once (NULLs stay allowed
  // for free-form products). Also serves lookups by shopId.
  @@unique([shopId, catalogItemId])
  @@index([shopId])
  @@index([catalogItemId])
  @@index([categoryId])
  @@index([name])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  updatedById String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  updatedById String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  updatedById String?

  @@unique([identifier, token])
}

model PasswordResetToken {
  id          String   @id @default(cuid())
  email       String
  token       String   @unique
  expires     DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  updatedById String?

  @@index([email])
}

model LoginSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Client info
  userAgent   String?
  ip          String?
  deviceLabel String? // e.g. "Chrome on Windows"

  // Lifecycle
  createdAt    DateTime  @default(now())
  lastActiveAt DateTime  @default(now())
  revokedAt    DateTime?

  updatedAt   DateTime @default(now()) @updatedAt
  createdById String?
  updatedById String?

  @@index([userId])
}

// Append-only history of changes. Rows are written by database triggers on every audited table
// (and by logActivity() for events that are not row changes, such as logins or impersonation).
// The application never updates or deletes rows. No foreign keys, so history survives the
// deletion of users, shops and records. Actor name and role are copied at write time.
model ActivityLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  entityType String
  entityId   String?
  shopId String? // set for shop-scoped records; powers the shop activity feed
  action     String
  changes    Json? // [{ field, from, to }] with secrets redacted
  note       String?

  actorId         String?
  actorName       String?
  actorRole       String?
  onBehalfOfId    String? // the user being impersonated, if any
  impersonationId String?

  source    String  @default("SYSTEM")
  requestId String?
  ip        String?
  userAgent String?

  @@index([entityType, entityId, createdAt])
  @@index([shopId, createdAt])
  @@index([actorId, createdAt])
}

// ACCESS CONTROL (see docs/access-audit-support.md section 1, and lib/access)
// A role is a named list of permission keys ("module.resource.action"; "*" = everything). The keys
// live in code (lib/access/catalogue.ts); the database only stores strings, so adding a permission
// never needs a migration. Every role works the same way: there are no special roles. "Owner",
// "Manager" and the rest are only defaults that are copied into a business or a shop when it is
// created (lib/access/role-templates.ts, lib/access/role-seed.ts) and can be edited or deleted.
// Who owns the role decides where it can be used:
//   businessId set  = a business role: usable in that business and in any of its shops (scope BUSINESS)
//   shopId set  = a shop role: usable in that one shop only (scope SHOP)
//   neither         = a platform role for Bayna staff (scope PLATFORM)
// Never both. Names are unique per owner (checked in code, lib/access/role-seed.ts).
model AccessRole {
  id          String      @id @default(cuid())
  name        String
  description String?
  scope       AccessScope // follows the owner, kept for easy queries
  businessId  String?
  business    Business?   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  shopId  String?
  shop    Shop?       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  permissions String[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  assignments AccessAssignment[]
  invites     AccessInvite[]

  @@index([scope])
  @@index([businessId])
  @@index([shopId])
}

// Gives one user one role, platform-wide, for a whole business, or inside one shop. A user can hold
// several. Effective permissions = the union of the permissions of their live roles (no grants, no
// denies). A business role may be given for one shop of its business (scope SHOP); a shop role only
// for its own shop.
model AccessAssignment {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId     String
  role       AccessRole       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  scope      AccessScope
  shopId String? // the shop, for SHOP scope; null otherwise
  shop   Shop?            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  businessId String? // the business, for BUSINESS scope; null otherwise
  business   Business?        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  status     AssignmentStatus @default(ACTIVE)

  expiresAt DateTime? // time-boxed access

  invitedById String? // who handed this access out (plain id, like the audit columns)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([userId, status])
  @@index([shopId])
  @@index([businessId])
  @@index([roleId])
}

// An invitation to join a business or a shop with a role (R2c). The owner copies the link and sends
// it; only a hash of the token is stored, so the link cannot be shown again (make a new one instead).
// Bound to one email address: whoever opens the link must be signed in with that address.
// Whether it is still usable is worked out from status + expiresAt (lib/access/invite-token.ts).
model AccessInvite {
  id         String      @id @default(cuid())
  scope      AccessScope // SHOP or BUSINESS (never PLATFORM)
  shopId String? // the shop, for SHOP scope
  shop   Shop?       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  businessId String? // the business, for BUSINESS scope
  business   Business?   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  roleId     String
  role       AccessRole  @relation(fields: [roleId], references: [id], onDelete: Restrict)

  email     String // normalised (trimmed, lowercase)
  tokenHash String       @unique // sha256 of the token in the link
  status    InviteStatus @default(PENDING)
  expiresAt DateTime

  acceptedAt   DateTime?
  acceptedById String? // plain id, like the audit columns
  revokedAt    DateTime?
  invitedById  String? // who handed this invitation out

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([shopId, status])
  @@index([businessId, status])
  @@index([email])
}

// Counters behind the rate limiter (lib/rate-limit). The key is a hash, never an email or an IP. Rows are
// throwaway: they expire with their window and are swept now and then, and they are not audit-logged.
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([resetAt])
}

// A message for one person, shown in the bell in the header. Created by notify() inside the same
// transaction as the event it reports. The event itself is already in ActivityLog, so this table is
// stamped (audit columns) but does not write log rows (see the notifications migration).
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   String // for example "shop.application.approved"; a string so new kinds need no migration
  title  String
  body   String?
  href   String? // where the notification leads, a path inside the app
  readAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ---- Plans -----------------------------------------------------------------------------------
// A free plan with limits and paid plans that raise them (decision 4 of 16 Oct 2026). The plan belongs
// to the BUSINESS: it is the account holder, and limits count across all of its shops. A business with
// no Subscription row is on the free plan, so nothing has to be created for existing businesses.
// The default plans and their limits live in lib/plans.ts and are copied here by `npm run seed plans`.

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Plan {
  id           String   @id @default(cuid())
  key          String   @unique // FREE, PRO, BUSINESS
  name         String
  description  String?
  // Prices in TND; null = free, or not decided yet (the Subscription page says "price on request").
  // Stored, not worked out: the yearly price is its own number (a small discount on 12 months), so each
  // can be changed on its own. Change them with `npm run db:set-price`.
  priceMonthly Decimal? @db.Decimal(12, 3)
  priceYearly  Decimal? @db.Decimal(12, 3)
  // { "shops": 1, "products": 50, "teamSeats": 1 }; a missing or null key means no limit
  limits       Json     @default("{}")
  // { "advancedReports": true, "bulkImport": false }
  features     Json     @default("{}")
  sortOrder    Int      @default(0)
  // Shown on the Business Subscription page
  isPublic     Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  subscriptions Subscription[]
}

model Subscription {
  id                 String             @id @default(cuid())
  businessId         String             @unique
  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planId             String
  plan               Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  status             SubscriptionStatus @default(ACTIVE)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  canceledAt         DateTime?
  // Set by hand by the platform team until a payment method exists (npm run db:set-plan)
  note               String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([planId])
}

// ---- Contact page ----------------------------------------------------------------------------
// What a visitor sends from /contact. The team reads and handles these in the admin area (Messages);
// they are the first part of the Support module's inbox. Anyone can send one, signed in or not.

enum ContactTopic {
  ACCOUNT
  SHOP
  LISTING
  PRIVACY
  PARTNER
  OTHER
}

enum ContactStatus {
  NEW
  READ
  HANDLED
}

model ContactMessage {
  id          String        @id @default(cuid())
  name        String
  email       String
  topic       ContactTopic
  message     String
  status      ContactStatus @default(NEW)
  // Set when the sender was signed in
  userId      String?
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Kept to limit abuse (a few messages per hour); not shown outside the admin area
  ip          String?
  userAgent   String?
  handledAt   DateTime?
  handledById String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([status, createdAt])
  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// "View as": a platform staff member looks at the app as another person (docs/access-audit-support.md, section 3).
// Read-only for now (mode WRITE is reserved). One open session per admin; it ends at expiresAt or when the admin
// exits. The ids are plain strings, like the audit columns, so User needs no relation line. Rules: lib/impersonation.ts.
enum ImpersonationMode {
  READ_ONLY
  WRITE
}

model ImpersonationSession {
  id           String            @id @default(cuid())
  adminId      String // the real person (platform staff)
  targetUserId String // the account being viewed
  mode         ImpersonationMode @default(READ_ONLY)
  reason       String
  // Set when the session was started from a support ticket (Support module)
  ticketId     String?
  startedAt    DateTime          @default(now())
  expiresAt    DateTime
  endedAt      DateTime?
  // ADMIN (clicked Exit), EXPIRED (found past its time), SIGNED_OUT (the staff member signed out), STAFF (ended by another staff member)
  endedBy      String?
  ip           String?
  userAgent    String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  @@index([adminId, endedAt])
  @@index([targetUserId, startedAt])
}

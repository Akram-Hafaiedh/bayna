# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/bayna?schema=public"

# NextAuth
AUTH_SECRET="generate-a-long-random-string-here"   # e.g. openssl rand -base64 32
AUTH_URL="http://localhost:3000"

# Plans: set to "on" to make plan limits stop actions (new shop, new product, new team member).
# Off by default, so limits are only shown on Business > Subscription.
# PLAN_LIMITS=on

# Company details printed on the Terms, Privacy and Contact pages (all optional in development)
# NEXT_PUBLIC_COMPANY_NAME=""
# NEXT_PUBLIC_COMPANY_ADDRESS=""
# NEXT_PUBLIC_CONTACT_EMAIL=""

# Optional (later)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
